<?xml version="1.0" encoding="utf-8"?>
<!--
    Navidrome often lives on a home network at a plain-http address, or behind
    a certificate the owner installed on their phone. Allow both.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
