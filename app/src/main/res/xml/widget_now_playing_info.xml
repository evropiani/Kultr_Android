<?xml version="1.0" encoding="utf-8"?>
<!-- Now-playing widget: 4×1 by default, resizable. The configure activity
     opens when it is placed (and again on reconfigure) to set its opacity. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.kultr.android.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_now_playing"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:previewLayout="@layout/widget_now_playing"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable" />
