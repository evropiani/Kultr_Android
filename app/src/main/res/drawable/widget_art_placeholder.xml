<?xml version="1.0" encoding="utf-8"?>
<!-- Shown before any artwork has loaded, or when nothing has played yet. It is
     large so the widget can scale it down to whatever size the artwork has;
     the note keeps its proportion. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF22222E" />
            <corners android:radius="19dp" />
            <size
                android:width="160dp"
                android:height="160dp" />
        </shape>
    </item>
    <item
        android:bottom="52dp"
        android:drawable="@drawable/ic_widget_note"
        android:left="52dp"
        android:right="52dp"
        android:top="52dp" />
</layer-list>
