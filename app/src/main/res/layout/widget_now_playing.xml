<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing widget: one centred group of the artwork (optional) and,
     beside it, the title, the artist and the controls, centred on one another.

     Sizes here are the defaults for a 4×1 widget and the widget picker's
     preview; NowPlayingWidget scales them to the widget's actual size (see
     WidgetLayout). The artwork and buttons are wrap_content with adjusted
     view bounds, so their max width and height set their size.

     The background is its own view so its opacity can be set per widget
     without touching the artwork, text or buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_open"
            android:maxWidth="84dp"
            android:maxHeight="84dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:id="@+id/widget_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="13dp">

            <LinearLayout
                android:id="@+id/widget_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/widget_idle_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:width="190dp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/widget_idle_subtitle"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp"
                    android:width="190dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <ImageButton
                    android:id="@+id/widget_previous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_previous"
                    android:maxWidth="44dp"
                    android:maxHeight="34dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_previous" />

                <ImageButton
                    android:id="@+id/widget_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_play"
                    android:maxWidth="51dp"
                    android:maxHeight="41dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_next"
                    android:maxWidth="44dp"
                    android:maxHeight="34dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
